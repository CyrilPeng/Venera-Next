<?xml version="1.0" encoding="UTF-8"?>
<ACBF xmlns="http://www.acbf.info/xml/acbf/1.1">
  <meta-data>
    <book-info>
      <author><nickname>Comic subtitle fixtures</nickname></author>
      <book-title>山路 / Mountain Path</book-title>
      <genre>other</genre>
      <coverpage><image href="#ridge.png"/></coverpage>
      <languages><text-layer lang="ja" show="true"/><text-layer lang="zh" show="true"/></languages>
    </book-info>
  </meta-data>
  <body>
    <page>
      <image href="#ridge.png"/>
      <text-layer lang="ja"><text-area points="52,32 139,32 139,119 52,119"><p>山の下</p></text-area></text-layer>
      <text-layer lang="zh"><text-area points="52,32 139,32 139,119 52,119"><p>山脚下</p></text-area></text-layer>
    </page>
    <page>
      <image href="#gate.png"/>
      <text-layer lang="ja"><text-area points="136,46 248,46 248,108 136,108"><p>入口</p></text-area></text-layer>
      <text-layer lang="zh"><text-area points="136,46 248,46 248,108 136,108"><p>入口处</p></text-area></text-layer>
    </page>
    <page>
      <image href="#dawn.png"/>
      <text-layer lang="zh">
        <text-area points="44,62 130,62 130,108 44,108"><p>山口</p></text-area>
        <text-area points="50,642 150,642 150,706 50,706"><p>日出</p></text-area>
      </text-layer>
    </page>
  </body>
  <data>
    <binary id="ridge.png" content-type="image/png"></binary>
    <binary id="gate.png" content-type="image/png"></binary>
    <binary id="dawn.png" content-type="image/png"></binary>
  </data>
