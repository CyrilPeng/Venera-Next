import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:venera_saf/src/native_backend.dart';
import 'package:venera_saf/src/overrides.dart';
import 'package:venera_saf/venera_saf.dart';

const control = MethodChannel('saf_probe/control');
const rootPath = 'android://probe:目录/授权根';
const shortPath = 'android://probe:目录';
const mirrorRoot = 'probe:镜像根';
const alias = 'com.cyrilpeng.venera_saf_probe_provider.alias';
final steps = <String>[];

void check(bool value, String message) { if (!value) throw StateError(message); }
void passed(String message) { steps.add(message); print('VENERA_SAF_PROBE_STEP $message'); }
Future<void> rejects(FutureOr<void> Function() operation, [String? message]) async {
  try { await operation(); } on FileSystemException catch (error) {
    if (message != null) check(error.toString().contains(message), 'Unexpected error: $error');
    return;
  }
  throw StateError('An invalid provider operation was accepted');
}
Future<Map> stats() async => (await control.invokeMethod<Map>('stats'))!;
Future<Map> balanced() async {
  for (var i = 0; i < 100; i++) {
    final value = await stats();
    if (value['opens'] == value['closes']) return value;
    await Future<void>.delayed(const Duration(milliseconds: 20));
  }
  throw StateError('Provider close callbacks remained unbalanced: ${await stats()}');
}

Future<Map<String, Object?>> probe() async {
  final phase = (await control.invokeMethod<String>('phase'))!;
  await SAFTaskWorker().init();
  await SAFTaskWorker().init();
  try {
    return await IOOverrides.runWithIOOverrides(() async {
      final root = AndroidDirectory.fromPathSync(rootPath)!;
      if (phase == 'initial') {
        await control.invokeMethod('reset');
        await control.invokeMethod('revoke', {'authority': alias});
        await control.invokeMethod('revoke', {'root': mirrorRoot});
        check(await control.invokeMethod<String>('grant') == rootPath, 'Wrong persisted tree ID');
        await control.invokeMethod<String>('grant', {'root': 'probe:目录'});
        check(root.parent.path == 'android://', 'A slash inside a tree ID was treated as a directory separator');
        await File('$shortPath/marker').writeAsString('short');
        await File('$rootPath/marker').writeAsString('long');
        check(await File('$shortPath/marker').readAsString() == 'short', 'Short grant changed');
        check(await File('$rootPath/marker').readAsString() == 'long', 'Longest tree ID was not selected');
        passed('persisted grants and longest complete tree ID');

        final folder = Directory('$rootPath/章节:📖|中文');
        await folder.create();
        final file = File('${folder.path}/页:😀|1.txt');
        final original = Uint8List.fromList([88, 1, 2, 3, 99]);
        await file.writeAsBytes(Uint8List.sublistView(original, 1, 4), flush: true);
        await file.create();
        check((await file.readAsBytes()).join(',') == '1,2,3', 'Create truncated existing bytes or typed view shifted');
        check((await folder.list().toList()).single.path == file.path, 'Unicode display name changed');
        await file.writeAsString('中文😀', mode: FileMode.append);
        final append = await file.open(mode: FileMode.append);
        final length = await append.length();
        check(await append.position() == length, 'Append did not start at EOF');
        await append.setPosition(0);
        await append.writeByte(7);
        check(await append.length() == length + 1, 'Append overwrote an existing byte');
        await append.close();
        passed('Unicode metadata, typed views, create and append');

        final before = await balanced();
        final raf = await file.open(mode: FileMode.write);
        await raf.writeFrom([9, 4, 5, 6, 8], 1, 4);
        await raf.setPosition(1);
        final into = [77, 77, 77, 77];
        check(await raf.readInto(into, 1, 3) == 2 && into.join(',') == '77,5,6,77', 'readInto changed its range');
        await raf.truncate(2);
        await raf.flush();
        final during = await stats();
        check(during['opens'] == (during['closes'] as int) + 1, 'Original ParcelFileDescriptor closed before file operations ended');
        check((during['closes'] as int) == (before['closes'] as int), 'Write committed before explicit close');
        await raf.close();
        await balanced();
        passed('provider ownership and explicit close callback');

        final sparse = await File('$rootPath/sparse').open(mode: FileMode.write);
        const offset = 0x80000000 + 71;
        await sparse.setPosition(offset);
        await sparse.writeByte(42);
        check(await sparse.length() == offset + 1, 'Sparse file length lost 64-bit precision');
        await sparse.setPosition(offset);
        check(await sparse.readByte() == 42, 'Sparse read failed');
        await sparse.truncate(0);
        await sparse.close();
        passed('64-bit sparse seek, read, length and truncate');

        final stream = File('$rootPath/stream');
        await stream.writeAsBytes(List.generate(150000, (index) => index % 256));
        check((await stream.openRead(17, 26).expand((chunk) => chunk).toList()).join(',') == '17,18,19,20,21,22,23,24,25', 'Stream range changed');
        check((await stream.openRead().first).length == 65536, 'First stream chunk changed');
        check(nativeDescriptorCount() == 0, 'Stream cancellation leaked a native descriptor');
        await File('$rootPath/empty').openWrite().close();
        check(await File('$rootPath/empty').length() == 0, 'Empty sink did not create a file');
        passed('streams, cancellation and empty sinks');

        final staged = File('$rootPath/staged')..writeAsStringSync('keep');
        final renamed = await staged.rename('$rootPath/renamed');
        final occupied = File('$rootPath/occupied')..writeAsStringSync('original');
        await rejects(() async { await renamed.rename(occupied.path); });
        check(await occupied.readAsString() == 'original', 'Rename replaced a collision');
        await rejects(() async { await occupied.copy('${occupied.path}/'); }, 'equal');
        await control.invokeMethod('grant', {'root': mirrorRoot});
        try {
          final mirror = 'android://$mirrorRoot/occupied';
          await rejects(() async { await occupied.copy(mirror); }, 'same document');
          await rejects(() { occupied.copySync(mirror); }, 'same document');
          check(await occupied.readAsString() == 'original', 'Copy through a grant alias truncated its source');
          final copied = await occupied.copy('android://$mirrorRoot/copied');
          check(await copied.readAsString() == 'original', 'Copy to a new mirror document failed');
        } finally { await control.invokeMethod('revoke', {'root': mirrorRoot}); }
        passed('normalized copy paths and shared document identities');
        await rejects(() => root.deleteSync(recursive: true));
        await rejects(() async { await File('$rootPath/auto.wrong').create(); }, 'changed');
        check(!File('$rootPath/auto.wrong.changed').existsSync(), 'Unexpected created name was left behind');
        passed('same-directory rename, collisions and root protection');

        final remote = File('$rootPath/remote-error')..createSync();
        final failing = await remote.open();
        await rejects(() => failing.close(), 'synthetic provider close error');
        check(nativeDescriptorCount() == 0, 'Failed close retained its native lease');
        passed('remote provider close errors');

        await control.invokeMethod('offline', {'enabled': true});
        try { await rejects(() async { await root.exists(); }, 'unavailable'); }
        finally { await control.invokeMethod('offline', {'enabled': false}); }
        await control.invokeMethod('revoke');
        await rejects(() async { await root.exists(); }, 'revoked');
        await control.invokeMethod('grant');
        check(await File('$rootPath/marker').readAsString() == 'long', 'Regrant lost existing data');
        await control.invokeMethod('grant', {'authority': alias});
        await rejects(() async { await root.exists(); }, 'Multiple');
        await control.invokeMethod('revoke', {'authority': alias});
        await File('$rootPath/persisted.txt').writeAsString('persistent 中文😀');
        passed('unavailable provider, revoked grant, regrant and authority ambiguity');
      } else {
        check(await root.exists(), 'Directory grant did not survive restart');
        check(await File('$rootPath/persisted.txt').readAsString() == 'persistent 中文😀', 'Stored path changed after restart');
        check((await Directory('android://').list().toList()).length == 2, 'Persisted roots were not restored');
        passed('process restart and persisted URI grants');
      }
      check(nativeDescriptorCount() == 0, 'Native descriptors remain open');
      final finalStats = await balanced();
      return {'ok': true, 'phase': phase, 'steps': steps, 'nativeDescriptors': nativeDescriptorCount(), 'providerStats': finalStats};
    }, SafIOOverrides());
  } finally { await SAFTaskWorker().dispose(); }
}

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  final result = Completer<String>();
  runApp(MaterialApp(home: Scaffold(body: Center(child: FutureBuilder<String>(
    future: result.future, builder: (_, state) => Text(state.data ?? 'Running SAF provider regression'),
  )))));
  WidgetsBinding.instance.addPostFrameCallback((_) async {
    Map<String, Object?> report;
    try { report = await probe().timeout(const Duration(seconds: 60)); }
    catch (error, stack) { report = {'ok': false, 'error': error.toString(), 'stack': stack.toString(), 'steps': steps}; }
    final text = jsonEncode(report);
    print('VENERA_SAF_PROBE_RESULT $text');
    result.complete(text);
  });
}
